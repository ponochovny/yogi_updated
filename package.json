{
  "name": "yogi_updated",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "build": "nuxt build && npm run db:migrate",
    "db:auth:generate": "npx auth@latest generate --config server/utils/auth/index.ts --output server/utils/db/auth-schema.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.16.0",
    "@neondatabase/neon-js": "^0.6.1-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@nuxt/a11y": "^1.0.0-alpha.1",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/test-utils": "^4.0.3",
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/eslint-module": "^4.1.0",
    "@nuxtjs/i18n": "^10.4.0",
    "@nuxtjs/leaflet": "^1.3.2",
    "@nuxtjs/seo": "^5.1.3",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^0.11.3",
    "@tailwindcss/vite": "^4.3.0",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.3.0",
    "better-auth": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.4",
    "nuxt": "^4.4.6",
    "nuxt-vitalizer": "^2.0.0",
    "pg": "^8.21.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.8",
    "shadcn-nuxt": "^2.7.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7",
    "vue-sonner": "^2.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/test-utils": "^2.4.10",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.9.0",
    "playwright-core": "^1.60.0",
    "tsx": "^4.22.3",
    "tw-animate-css": "^1.4.0",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "zod": "^4.4.3",
    "@better-auth/passkey": {
      "@better-auth/core": "$@better-auth/core",
      "better-auth": "$better-auth"
    }
  }
}
